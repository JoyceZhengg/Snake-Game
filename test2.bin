@0
// MOVL r0, 0x00
00110000 00000000
// MOVH r0, 0x00
00111000 00000000
// MOVL r5, 0x00
00110000 00000101
// MOVH r5, 0xD0
00111110 10000101
// LDR  r2, r5                // r2 = button value
11111001 01000010
// MOVL r6, lo(draw_square)
00110010 11000110
// MOVH r6, hi(draw_square)
00111000 00000110
// BEQ  r6, r2, r0            // if r2 == 0, use green (0x00)
01001000 10000110
// MOVL r3, 0x04
00110000 00100011
// MOVL r6, lo(button_up)
00110001 11000110
// MOVH r6, hi(button_up)
00111000 00000110
// BEQ  r6, r2, r3
01001000 10011110
// MOVL r3, 0x08
00110000 01000011
// MOVL r6, lo(button_left)
00110010 00000110
// MOVH r6, hi(button_left)
00111000 00000110
// BEQ  r6, r2, r3
01001000 10011110
// MOVL r3, 0x02
00110000 00010011
// MOVL r6, lo(button_down)
00110010 01000110
// MOVH r6, hi(button_down)
00111000 00000110
// BEQ  r6, r2, r3
01001000 10011110
// MOVL r3, 0x01
00110000 00001011
// MOVL r6, lo(button_right)
00110010 10000110
// MOVH r6, hi(button_right)
00111000 00000110
// BEQ  r6, r2, r3
01001000 10011110
// MOVL r2, 0x00
00110000 00000010
// MOVL r6, lo(draw_square)
00110010 11000110
// MOVH r6, hi(draw_square)
00111000 00000110
// BR   r6
01000000 00000110
// MOVL r2, 0x01              // Blue
00110000 00001010
// MOVL r6, lo(draw_square)
00110010 11000110
// MOVH r6, hi(draw_square)
00111000 00000110
// BR   r6
01000000 00000110
// MOVL r2, 0x01              // Blue
00110000 00001010
// MOVL r6, lo(draw_square)
00110010 11000110
// MOVH r6, hi(draw_square)
00111000 00000110
// BR   r6
01000000 00000110
// MOVL r2, 0x10              // Yellow
00110000 10000010
// MOVL r6, lo(draw_square)
00110010 11000110
// MOVH r6, hi(draw_square)
00111000 00000110
// BR   r6
01000000 00000110
// MOVL r2, 0x10              // Yellow
00110000 10000010
// MOVL r6, lo(draw_square)
00110010 11000110
// MOVH r6, hi(draw_square)
00111000 00000110
// BR   r6
01000000 00000110
// MOVL r1, 0x08
00110000 01000001
// MOVH r1, 0xA2              // r1 = 0xA208
00111101 00010001
// MOVL r4, 12                // 12 rows
00110000 01100100
// ADD  r3, r1, r0            // r3 = row start
00100000 01000011
// MOVL r6, 16                // 16 columns
00110000 10000110
// STR  r3, r2                // Draw pixel with color r2
11111000 11001010
// ADDI r3, 1
00010000 00001011
// SUBI r6, 1
00011000 00001110
// MOVL r7, lo(draw_cols)
00110011 00010111
// MOVH r7, hi(draw_cols)
00111000 00000111
// BNE  r7, r6, r0
01001011 10000111
// ADDI r1, 160               // Next row
00010101 00000001
// SUBI r4, 1
00011000 00001100
// MOVL r7, lo(draw_rows)
00110010 11110111
// MOVH r7, hi(draw_rows)
00111000 00000111
// BNE  r7, r4, r0
01001011 00000111
// MOVL r3, 0xFF
00110111 11111011
// MOVH r3, 0x0F
00111000 01111011
// SUBI r3, 1
00011000 00001011
// MOVL r7, lo(delay_loop)
00110011 11100111
// MOVH r7, hi(delay_loop)
00111000 00000111
// BNE  r7, r3, r0
01001010 11000111
// MOVL r7, lo(loop)
00110000 00100111
// MOVH r7, hi(loop)
00111000 00000111
// BR   r7
01000000 00000111
